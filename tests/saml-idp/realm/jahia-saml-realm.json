{
    "realm": "jahia-saml",
    "displayName": "Jahia SAML test IdP",
    "enabled": true,
    "sslRequired": "none",
    "registrationAllowed": false,
    "loginTheme": "keycloak",
    "clients": [
        {
            "clientId": "jahia-digitall",
            "name": "Jahia digitall (saml-login-provider test SP)",
            "description": "Must match Saml.relyingPartyIdentifier in org.jahia.modules.auth-<site>.cfg.",
            "enabled": true,
            "protocol": "saml",
            "publicClient": true,
            "frontchannelLogout": true,
            "redirectUris": ["http://digitall.localhost:8080/*", "http://digitall.jahia.test:8080/*"],
            "baseUrl": "http://digitall.localhost:8080/",
            "adminUrl": "http://digitall.localhost:8080/home.callback.saml",
            "attributes": {
                "saml.authnstatement": "true",
                "saml.server.signature": "true",
                "saml.assertion.signature": "true",
                "saml.signature.algorithm": "RSA_SHA256",
                "saml.client.signature": "false",
                "saml_name_id_format": "username",
                "saml_force_name_id_format": "true",
                "saml.force.post.binding": "true",
                "saml_single_logout_service_url_redirect": "http://digitall.localhost:8080/home.html"
            },
            "protocolMappers": [
                {
                    "name": "username",
                    "protocol": "saml",
                    "protocolMapper": "saml-user-property-mapper",
                    "consentRequired": false,
                    "config": {
                        "user.attribute": "username",
                        "attribute.name": "username",
                        "attribute.nameformat": "Basic"
                    }
                },
                {
                    "name": "email",
                    "protocol": "saml",
                    "protocolMapper": "saml-user-property-mapper",
                    "consentRequired": false,
                    "config": {
                        "user.attribute": "email",
                        "attribute.name": "email",
                        "attribute.nameformat": "Basic"
                    }
                },
                {
                    "name": "firstName",
                    "protocol": "saml",
                    "protocolMapper": "saml-user-property-mapper",
                    "consentRequired": false,
                    "config": {
                        "user.attribute": "firstName",
                        "attribute.name": "firstName",
                        "attribute.nameformat": "Basic"
                    }
                },
                {
                    "name": "lastName",
                    "protocol": "saml",
                    "protocolMapper": "saml-user-property-mapper",
                    "consentRequired": false,
                    "config": {
                        "user.attribute": "lastName",
                        "attribute.name": "lastName",
                        "attribute.nameformat": "Basic"
                    }
                }
            ]
        },
        {
            "clientId": "jahia-systemsite",
            "name": "Jahia systemsite (saml-login-provider test SP)",
            "description": "Must match Saml.relyingPartyIdentifier in org.jahia.modules.auth-<site>.cfg.",
            "enabled": true,
            "protocol": "saml",
            "publicClient": true,
            "frontchannelLogout": true,
            "redirectUris": ["http://localhost:8080/*"],
            "baseUrl": "http://localhost:8080/",
            "adminUrl": "http://localhost:8080/home.callback.saml",
            "attributes": {
                "saml.authnstatement": "true",
                "saml.server.signature": "true",
                "saml.assertion.signature": "true",
                "saml.signature.algorithm": "RSA_SHA256",
                "saml.client.signature": "false",
                "saml_name_id_format": "username",
                "saml_force_name_id_format": "true",
                "saml.force.post.binding": "true",
                "saml_single_logout_service_url_redirect": "http://localhost:8080/home.html"
            },
            "protocolMappers": [
                {
                    "name": "username",
                    "protocol": "saml",
                    "protocolMapper": "saml-user-property-mapper",
                    "consentRequired": false,
                    "config": {
                        "user.attribute": "username",
                        "attribute.name": "username",
                        "attribute.nameformat": "Basic"
                    }
                },
                {
                    "name": "email",
                    "protocol": "saml",
                    "protocolMapper": "saml-user-property-mapper",
                    "consentRequired": false,
                    "config": {
                        "user.attribute": "email",
                        "attribute.name": "email",
                        "attribute.nameformat": "Basic"
                    }
                },
                {
                    "name": "firstName",
                    "protocol": "saml",
                    "protocolMapper": "saml-user-property-mapper",
                    "consentRequired": false,
                    "config": {
                        "user.attribute": "firstName",
                        "attribute.name": "firstName",
                        "attribute.nameformat": "Basic"
                    }
                },
                {
                    "name": "lastName",
                    "protocol": "saml",
                    "protocolMapper": "saml-user-property-mapper",
                    "consentRequired": false,
                    "config": {
                        "user.attribute": "lastName",
                        "attribute.name": "lastName",
                        "attribute.nameformat": "Basic"
                    }
                }
            ]
        }
    ],
    "users": [
        {
            "username": "saml.tester",
            "enabled": true,
            "emailVerified": true,
            "email": "saml.tester@example.com",
            "firstName": "Saml",
            "lastName": "Tester",
            "realmRoles": ["default-roles-jahia-saml"]
        }
    ]
}
