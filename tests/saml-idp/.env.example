# Copy to .env before running ./setup.sh. .env is gitignored.
#
# These are disposable fixture credentials for a Keycloak bound to 127.0.0.1 only and for a Jahia
# test user created inside the demo site. They are not secrets in any meaningful sense, but they
# are kept out of git so that nothing in the repository ever ships a working credential.

# Keycloak admin console (http://localhost:8180/admin)
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-admin

# The SAML end user you will log in as, created in the jahia-saml realm by setup.sh
SAML_TEST_USER=saml.tester
SAML_TEST_USER_PASSWORD=change-me-user

# Keystore passphrases for the SP keystore that saml-authentication-valve generates for itself.
# Any non-empty value works; they only protect a throwaway self-signed SP key.
SAML_KEYSTORE_PASS=change-me-keystore
SAML_PRIVATE_KEY_PASS=change-me-privatekey

# The site the SAML connector is bound to, and the hostname made to resolve to it.
#
# On a stock tests/ stack both systemsite and digitall carry j:serverName=localhost, systemsite
# wins the lookup, and no other host resolves to anything. setup.sh therefore adds SITE_HOST to
# digitall's j:serverNameAliases (additive; systemsite is untouched) and you browse the SP at
# SITE_HOST. 127.0.0.1 is the default because it needs no DNS entry or hosts file.
#
# Changing SITE_HOST to something else also means updating redirectUris and the
# saml_assertion_consumer_url_* attributes in realm/jahia-saml-realm.json.
SITE_KEY=digitall
SITE_HOST=127.0.0.1
POST_LOGIN_PATH=/home.html
# Derived from SITE_HOST when unset; override only if you moved Jahia off port 8080.
# JAHIA_PUBLIC_URL=http://127.0.0.1:8080

# Used for the provisioning API call that maps SITE_HOST to SITE_KEY. Matches tests/.env.
JAHIA_ADMIN_USER=root
SUPER_USER_PASSWORD=root1234
