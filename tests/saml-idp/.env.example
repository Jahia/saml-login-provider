# Copy to .env before running ./setup.sh. .env is gitignored.
#
# These are disposable fixture credentials for a Keycloak bound to 127.0.0.1 only and for a Jahia
# test user created inside the demo site. They are not secrets in any meaningful sense, but they
# are kept out of git so that nothing in the repository ever ships a working credential.

# Keycloak admin console (http://localhost:8180/admin)
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-admin

# The SAML end user you will log in as, created in the jahia-saml realm by setup.sh
SAML_TEST_USER=saml.tester
SAML_TEST_USER_PASSWORD=change-me-user

# No SP keystore settings: setup.sh has Jahia generate a fresh keystore with random passphrases on
# every run (cypress/fixtures/groovy/configureSamlConnector.groovy), so there is nothing to choose.

# The content site, and the hostname made to resolve to it. setup.sh puts a SAML connector on it
# AND on systemsite (which keeps answering on localhost), each with its own host in its SP URL, and
# puts SITE_HOST alone in saml-login-provider's host list.
#
# On a stock tests/ stack both systemsite and digitall carry j:serverName=localhost, systemsite
# wins the lookup, and no other host resolves to anything. setup.sh therefore gives digitall its
# own j:serverName (= SITE_HOST); systemsite is untouched.
#
# SITE_HOST must be a REAL hostname, never localhost or 127.0.0.1: Jahia rewrites site URLs to
# ABSOLUTE ones built from j:serverName, so a loopback literal ends up baked into every link on
# the site and is meaningless anywhere but this machine. digitall.localhost is a real name that
# still needs no hosts-file entry -- browsers and glibc/systemd-resolved map *.localhost to
# loopback.
#
# Changing SITE_HOST also means adding it to redirectUris in realm/jahia-saml-realm.json (the ACS
# URL itself is not pinned there: Keycloak takes it from each AuthnRequest).
SITE_KEY=digitall
SITE_HOST=digitall.localhost
POST_LOGIN_PATH=/home.html
# Override only if you moved Jahia off port 8080; every SP URL is http://<host>:JAHIA_PORT.
# JAHIA_PORT=8080

# Used for the provisioning API call that maps SITE_HOST to SITE_KEY. Matches tests/.env.
JAHIA_ADMIN_USER=root
SUPER_USER_PASSWORD=root1234
